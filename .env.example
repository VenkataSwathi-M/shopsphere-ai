# ==========================================
# APPLICATION CONFIGURATION
# ==========================================

APP_NAME=ShopSphere AI
APP_ENV=development

# ==========================================
# FRONTEND CONFIGURATION
# ==========================================

FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api/v1

# ==========================================
# SPRING BOOT CONFIGURATION
# ==========================================

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ==========================================
# POSTGRESQL CONFIGURATION
# ==========================================

POSTGRES_DB=shopsphere_db
POSTGRES_USER=shopsphere_user
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_PASSWORD
POSTGRES_PORT=5432

# ==========================================
# DATABASE CONNECTION
# ==========================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=shopsphere_db
DB_USERNAME=shopsphere_user
DB_PASSWORD=CHANGE_ME_LOCAL_PASSWORD

# ==========================================
# REDIS CONFIGURATION
# ==========================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==========================================
# JWT CONFIGURATION
# ==========================================

JWT_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_SECRET
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# ==========================================
# PYTHON AI SERVICE
# ==========================================

AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://localhost:8000

# ==========================================
# LLM CONFIGURATION
# ==========================================

LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# ==========================================
# RAZORPAY CONFIGURATION
# ==========================================

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ==========================================
# FILE UPLOAD CONFIGURATION
# ==========================================

MAX_FILE_SIZE=10485760
UPLOAD_DIRECTORY=uploads